{
  "name": "skylit",
  "version": "0.1.0",
  "description": "TypeScript client for Skylit market data: options flow, volatility, dealer positioning (GEX) and dark pool, for AI trading agents.",
  "license": "MIT",
  "author": "Skylit, Inc. <support@skylit.ai>",
  "homepage": "https://www.skylit.ai/docs",
