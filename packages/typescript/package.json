{
  "name": "@skylitai/sdk",
  "version": "0.1.3",
  "description": "TypeScript client for Skylit market data: options flow, volatility, dealer positioning (GEX) and dark pool, for AI trading agents.",
  "license": "MIT",
  "author": "Skylit, Inc. <support@skylit.ai>",
  "homepage": "https://www.skylit.ai/docs?utm_source=npm&utm_medium=developer&utm_campaign=api_distribution&utm_content=packages-typescript-package",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkylitAI/skylit-mcp.git",
    "directory": "packages/typescript"
  },
  "bugs": "https://github.com/SkylitAI/skylit-mcp/issues",
  "keywords": [
    "skylit",
    "options",
    "options-flow",
    "gamma-exposure",
    "gex",
    "volatility",
    "dark-pool",
    "mcp",
    "ai-agents",
    "trading"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/client.test.js",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
